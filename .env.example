# Servidor y Puerto (Node.js / Docker)
PORT=3000

# Secreto Criptográfico Maestro (HMAC-SHA256 y Pepper)
# ⚠️ En producción o Cloudflare Pages, genera una cadena pseudoaleatoria de alta entropía
PIN_SECRET=couvance_ops_super_secret_pepper_key_change_in_production

# Credenciales de Sembrado Inicial (Opcional, defaults a 12345678 / couvance / valencia)
INITIAL_PIN=12345678
SECURITY_Q1=¿Cuál es el nombre de tu primera mascota?
SECURITY_A1=couvance
SECURITY_Q2=¿En qué ciudad se fundó la agencia?
SECURITY_A2=valencia

# Conexión Local SQLite (Opcional, por defecto usa ./data/couvance-ops.db)
# DATABASE_URL=./data/couvance-ops.db
